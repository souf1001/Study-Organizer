# Domain, unter der die Web-Version erreichbar ist (Caddy holt automatisch ein HTTPS-Zertifikat)
DOMAIN=study.example.de

# Pflicht: 64 Hex-Zeichen zum Verschlüsseln von API-Keys. Erzeugen mit: openssl rand -hex 32
SECRET_KEY=

# Speicher pro Konto in MB und größte einzelne Datei in MB
USER_QUOTA_MB=500
MAX_UPLOAD_MB=200

# Neue Konten erlauben (auf false setzen, wenn alle Konten angelegt sind)
ALLOW_REGISTRATION=true

# Sitzungsdauer in Tagen
SESSION_DAYS=30

# Nur für private Installationen: Zugriff auf interne Adressen erlauben (z. B. Ollama im Heimnetz)
ALLOW_PRIVATE_NETWORK=false
